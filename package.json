{
  "name": "dsh-components",
  "version": "0.0.0",
  "packageManager": "pnpm@12.15.0",
  "description": "Source-level React components for the DeepSeek Harness Web UI, recovered from the official stylesheets",
  "author": "Anthony Fu <anthonyfu117@hotmail.com>",
  "license": "MIT",
  "funding": "https://github.com/sponsors/antfu",
  "homepage": "https://github.com/hairyf/dsh-components#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hairyf/dsh-components.git"
  },
  "bugs": "https://github.com/hairyf/dsh-components/issues",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "components",
    "react"
  ],
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.cjs",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.cts",
  "files": [
    "dist",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "playground": "pnpm --filter playground dev",
    "knip": "knip",
    "lint": "eslint src test scripts skills playground --no-warn-ignored",
    "prepack": "nr build",
    "release": "bumpp",
    "start": "tsx src/index.ts",
    "test": "pnpm run build && vitest",
    "typecheck": "tsc",
    "ci": "pnpm run lint && pnpm run typecheck && pnpm run knip && pnpm run audit:fidelity && pnpm run test --run",
    "gen": "node scripts/generate-skill-index.mjs",
    "gen:reference": "node scripts/extract-dsh-source.mjs && node scripts/extract-slots.mjs && node scripts/extract-locales.mjs && node scripts/generate-theme.mjs && node scripts/generate-components.mjs",
    "audit:fidelity": "node scripts/audit-fidelity.mjs"
  },
  "scripts-info": {
    "build": "Build the library for publishing",
    "dev": "Rebuild on change during development",
    "knip": "Find unused files, exports and dependencies",
    "lint": "Check for code style issues",
    "prepack": "Build before publishing",
    "release": "Bump version and publish a release",
    "start": "Run the entry file",
    "test": "Run the test suite",
    "typecheck": "Check types",
    "ci": "Run the full continuous integration pipeline",
    "prepare": "Set up git hooks and skills"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.2.2-rc.1",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:cli",
    "@antfu/ni": "catalog:cli",
    "@antfu/skills": "catalog:agentic",
    "@antfu/utils": "catalog:inlined",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.2.2-rc.1",
    "@types/node": "catalog:types",
    "@types/react": "catalog:types",
    "@types/react-dom": "catalog:types",
    "bumpp": "catalog:cli",
    "eslint": "catalog:cli",
    "eslint-plugin-slop": "catalog:cli",
    "eslint-plugin-sonarjs": "catalog:cli",
    "happy-dom": "20.14.6",
    "knip": "catalog:cli",
    "nano-staged": "catalog:cli",
    "publint": "catalog:cli",
    "react": "catalog:runtime",
    "react-dom": "catalog:runtime",
    "simple-git-hooks": "catalog:cli",
    "taze": "catalog:cli",
    "tsdown": "catalog:cli",
    "tsdown-stale-guard": "catalog:testing",
    "tsnapi": "catalog:testing",
    "tsx": "catalog:cli",
    "typescript": "catalog:cli",
    "vite": "catalog:cli",
    "vitest": "catalog:testing"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm i --frozen-lockfile --ignore-scripts --offline && pnpm run ci && pnpx nano-staged"
  },
  "nano-staged": {
    "src/**/*.{ts,tsx}": "eslint --fix --no-warn-ignored",
    "test/**/*.{ts,tsx}": "eslint --fix --no-warn-ignored",
    "scripts/**/*.mjs": "eslint --fix --no-warn-ignored",
    "skills/**/*.mjs": "eslint --fix --no-warn-ignored",
    "playground/**/*.{ts,tsx}": "eslint --fix --no-warn-ignored"
  },
  "dependencies": {
    "css-render": "catalog:",
    "anser": "^2.3.5",
    "clsx": "catalog:",
    "simple-icons": "catalog:",
    "shiki": "catalog:",
    "@shikijs/langs": "catalog:"
  },
  "main": "./dist/index.cjs",
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-modules"
      ],
      "external": [
        "react",
        "react-dom",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=22.18.0",
    "dsh": ">=0.2.2-rc.1"
  }
}
